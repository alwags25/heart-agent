{
  "_说明": "复制本文件为 config.json 后修改。provider 可选 openai(OpenAI兼容:GLM/DeepSeek等) / ollama / mock。api_key 可用环境变量 HEARTAGENT_MAIN_API_KEY / HEARTAGENT_ASSIST_API_KEY 覆盖。改完保存即热重载。",
  "main_model": {
    "provider": "openai",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key": "",
    "model": "glm-4.6"
  },
  "assist_model": {
    "provider": "openai",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key": "",
    "model": "glm-4-flash"
  },
  "embeddings": {"enabled": true, "base_url": "http://localhost:11434", "model": "nomic-embed-text"},
  "router": {"enabled": true, "max_len": 32,
             "local": {"provider": "ollama", "base_url": "http://localhost:11434", "model": "qwen2.5:0.5b"}},
  "peer_agents": [],
  "inbox": {"poll_sec": 60,
            "email": {"enabled": false, "host": "", "port": 993, "user": "", "password": "", "allow_from": []},
            "telegram": {"enabled": false, "token": "", "allow_chat_ids": []},
            "webhook": {"enabled": true, "allow_senders": []}},
  "curiosity": {"enabled": true, "explores_per_day": 5, "sources": []},
  "skill_harvest": {"enabled": true, "every_hours": 6, "min_new": 2},
  "prompt_evolution": {"enabled": false, "every_hours": 24, "sample_size": 4},
  "notifications": {"on_task_failure": true, "daily_report_push": false,
                    "channels": {"serverchan": {"enabled": false, "sendkey": ""},
                                 "wecom": {"enabled": false, "webhook": ""},
                                 "dingtalk": {"enabled": false, "webhook": ""},
                                 "feishu": {"enabled": false, "webhook": ""},
                                 "email": {"enabled": false, "host": "", "smtp_host": "", "port": 465, "user": "", "password": "", "to": ""},
                                 "desktop": {"enabled": false}}},
  "auto_approve_extensions": false,
  "second_opinion": {"enabled": true},
  "security": {"token": "", "restricted_token": false},
  "vision": {"model": ""},
  "autonomy": {"level": 2},
  "wallet": {"monthly_budget_cny": 50,
             "prices": {"glm-4.6": {"in": 2.0, "out": 8.0}, "glm-4-flash": {"in": 0.1, "out": 0.1}, "deepseek-chat": {"in": 2.0, "out": 8.0}}},
  "sleep_consolidation": {"enabled": true, "every_hours": 12, "decay_days": 30, "min_hits": 2, "max_conflict_checks": 20},
  "evals": {"enabled": true, "every_hours": 24},
  "daily_report": {"enabled": true, "hour": 9},
  "reflection": {"enabled": true, "every_hours": 6},
  "max_concurrent_tasks": 2,
  "ext_mem_limit_mb": 512,
  "heartbeat_interval_sec": 30,
  "idle_threshold_sec": 120,
  "ui_port": 8765,
  "data_dir": "data"
}
